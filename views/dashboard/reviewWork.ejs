<% layout("/layouts/boilerplate") %>
    <div class="main-title">
        <h2 class="fw-bold title-strip">
            Issue Review & Approval
        </h2>
    </div>

    <div class="container mt-4">

        <div class="review-card">

            <h4>
                <%= issue.title %>
            </h4>

            <p class="text-muted">
                <%= issue.description %>
            </p>

            <hr>

            <!-- Employee Info -->
            <h5 class="mt-3 mb-3">Assigned Employee</h5>
            <div class="employee-info">
                <p>
                    <strong>Username:</strong> @<%= issue.assignedTo.username %><br>
                        <strong>ID:</strong>
                        <%= issue.assignedTo.employeeId %><br>
                            <strong>Name:</strong>
                            <%= issue.assignedTo.firstName %>
                                <%= issue.assignedTo.lastName %><br>
                                    <strong>Email:</strong>
                                    <%= issue.assignedTo.email %><br>
                                        <strong>Phone:</strong>
                                        <%= issue.assignedTo.phone %>
                </p>
            </div>

            <hr>

            <!-- Work Proof -->
            <h5 class="mt-3 mb-3">Work Submitted</h5>

            <% if(issue.resolvedImage && issue.resolvedImage.url) { %>
                <img src="<%= issue.resolvedImage.url %>" class="review-img mb-3">
                <% } else { %>
                    <p class="no-image">No image uploaded</p>
                    <% } %>

                        <hr>

                        <!-- Actions -->
                        <div class="d-flex gap-2">

                            <form action="/dashboard/admin/<%= issue._id %>/approve?_method=PUT" method="POST">
                                <button class="btn btn-success">Approve</button>
                            </form>

                            <form action="/dashboard/admin/<%= issue._id %>/reject?_method=PUT" method="POST">
                                <button class="btn btn-danger">Reject</button>
                            </form>

                            <a href="/dashboard/admin" class="btn btn-secondary">
                                Back
                            </a>

                        </div>

        </div>

    </div>