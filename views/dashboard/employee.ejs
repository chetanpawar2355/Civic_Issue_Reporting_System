<% layout("/layouts/boilerplate") %>

    <div class="main-title">
        <h2 class="fw-bold title-strip">Assigned Issues</h2>
    </div>

    <div class="container">

        <!-- ================= ASSIGNED ================= -->
        <h4 class="section-heading">Assigned</h4>
        <div class="row g-3 mt-2 mb-4">
            <% issues.filter(i=> i.status === "assigned").forEach(issue => { %>
                <div class="col-md-6">
                    <div class="issue-card">

                        <div class="title-row">
                            <h4 class="mb-0">
                                <%= issue.title %>
                            </h4>
                            <span class="status <%= issue.status %>">
                                <%= issue.status %>
                            </span>
                        </div>
                        <hr>

                        <p class="text-muted small">
                            <%= issue.description %>
                        </p>

                        <!-- FORM -->
                        <form action="/dashboard/employee/<%= issue._id %>?_method=PUT" method="POST"
                            enctype="multipart/form-data" class="mt-3">
                            <select name="status" class="form-select mb-2" required>
                                <option value="">Update Status</option>
                                <option value="in-progress">Start Work</option>
                            </select>

                            <input type="file" name="resolvedImage" class="form-control mb-2">

                            <button class="btn submit-btn w-100">Update Status</button>
                        </form>

                    </div>
                </div>
                <% }) %>
        </div>
        <hr>


        <!-- ================= IN PROGRESS ================= -->
        <h4 class="section-heading mt-4">In Progress</h4>
        <div class="row g-3 mt-2 mb-4">
            <% issues.filter(i=> i.status === "in-progress").forEach(issue => { %>
                <div class="col-md-6">
                    <div class="issue-card">

                        <div class="title-row">
                            <h4 class="mb-0">
                                <%= issue.title %>
                            </h4>
                            <span class="status <%= issue.status %>">
                                <%= issue.status %>
                            </span>
                        </div>
                        <hr>

                        <p class="text-muted small">
                            <%= issue.description %>
                        </p>

                        <form action="/dashboard/employee/<%= issue._id %>?_method=PUT" method="POST"
                            enctype="multipart/form-data" class="mt-3">
                            <select name="status" class="form-select mb-2" required>
                                <option value="">Update Status</option>
                                <option value="pending-review">Send for Review</option>
                            </select>

                            <input type="file" name="resolvedImage" class="form-control mb-2">

                            <button class="btn submit-btn w-100">Update Status</button>
                        </form>

                    </div>
                </div>
                <% }) %>
        </div>
        <hr>


        <!-- ================= PENDING REVIEW ================= -->
        <h4 class="section-heading mt-4">Pending Review</h4>
        <div class="row g-3 mt-2 mb-4">
            <% issues.filter(i=> i.status === "pending-review").forEach(issue => { %>
                <div class="col-md-6">
                    <div class="issue-card">

                        <div class="title-row">
                            <h4 class="mb-0">
                                <%= issue.title %>
                            </h4>
                            <span class="status <%= issue.status %>">
                                <%= issue.status %>
                            </span>
                        </div>
                        <hr>

                        <p class="text-muted small">
                            <%= issue.description %>
                        </p>

                        <p class="text-warning small mt-2">
                            Waiting for admin review...
                        </p>

                    </div>
                </div>
                <% }) %>
        </div>
        <hr>


        <!-- ================= RESOLVED ================= -->
        <h4 class="section-heading mt-4">Resolved</h4>
        <div class="row g-3 mt-2 mb-4">
            <% issues.filter(i=> i.status === "resolved").forEach(issue => { %>
                <div class="col-md-6">
                    <div class="issue-card">

                        <div class="title-row">
                            <h4 class="mb-0">
                                <%= issue.title %>
                            </h4>
                            <span class="status <%= issue.status %>">
                                <%= issue.status %>
                            </span>
                        </div>
                        <hr>

                        <p class="text-muted small">
                            <%= issue.description %>
                        </p>

                        <p class="text-success small mt-2">
                            Issue resolved successfully ✅
                        </p>

                    </div>
                </div>
                <% }) %>
        </div>

    </div>