<% layout("/layouts/boilerplate") %>

    <div class="container mt-4">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="fw-bold">Manage Employees</h2>

            <a href="/dashboard/admin/newEmployee" class="btn btn-warning">
                + Add Employee
            </a>
        </div>

        <div class="row g-3">
            <% employees.forEach(emp=> { %>
                <div class="col-md-4">
                    <div class="employee-card p-3">

                        <h5>
                            <%= emp.username %>
                        </h5>
                        <p class="mb-1"><strong>Email:</strong>
                            <%= emp.email %>
                        </p>
                        <p><strong style="color: black !important">ID:</strong>
                            <%= emp.employeeId %>
                        </p>
                        <form action="/dashboard/admin/employees/<%= emp._id %>?_method=DELETE" method="POST">
                            <button class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    </div>
                </div>
                <% }) %>
        </div>

    </div>