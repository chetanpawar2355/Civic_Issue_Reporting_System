<% layout("/layouts/boilerplate") %>

    <div class="main-title">
        <h2 class="fw-bold title-strip">Admin Dashboard</h2>
    </div>

    <div class="container mt-4">

        <!-- ===== STATS ===== -->
        <div class="row g-3 mb-4">
            <% const stats=[ {label: "Total" , value: issues.length}, {label: "Pending" , value: issues.filter(i=>
                i.status==="pending").length},
                {label: "Assigned", value: issues.filter(i=>i.status==="assigned").length},
                {label: "Progress", value: issues.filter(i=>i.status==="in-progress").length},
                {label: "Review", value: issues.filter(i=>i.status==="pending-review").length},
                {label: "Resolved", value: issues.filter(i=>i.status==="resolved").length}
                ]; %>

                <% stats.forEach(s=> { %>
                    <div class="col-6 col-md-2">
                        <div class="dashboard-card">
                            <h5>
                                <%= s.label %>
                            </h5>
                            <p>
                                <%= s.value %>
                            </p>
                        </div>
                    </div>
                    <% }) %>
        </div>

        <!-- ===== ACTION BUTTONS ===== -->
        <div class="action-buttons mb-4">
            <a href="/dashboard/admin/newEmployee" class="btn btn-warning">+ Add Employee</a>
            <a href="/dashboard/admin/employees" class="btn btn-outline-primary">Manage Employees</a>
        </div>

        <!-- ===== DESKTOP TABLE ===== -->
        <div class="table-card p-3 mb-5 desktop-only">

            <h5 class="fw-bold mb-3">📋 Issue Management</h5>

            <table class="table align-middle">
                <thead>
                    <tr>
                        <th>No.</th>
                        <th>Title</th>
                        <th>Details</th>
                        <th>Status</th>
                        <th>Assigned</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    <% issues.forEach(issue=> { %>

                        <tr>
                            <td>
                                <%= issues.indexOf(issue) + 1 %>.
                            </td>
                            <td>
                                <%= issue.title %>
                            </td>

                            <td>
                                <a href="/listings/<%= issue._id %>" class="btn btn-sm btn-outline-primary2">
                                    <i class="fa-solid fa-arrow-up-right-from-square"></i>
                                </a>
                            </td>

                            <td>
                                <span class="status <%= issue.status %>">
                                    <%= issue.status %>
                                </span>
                            </td>

                            <!-- 🔥 ASSIGNED USER WITH HOVER CARD -->
                            <td>
                                <div class="assigned-user">

                                    <% if(issue.assignedTo){ %>

                                        <i class="fa-solid fa-circle-info info-icon"></i>
                                        <span>@<%= issue.assignedTo.username %></span>

                                        <div class="user-card">
                                            <h5>
                                                <%= issue.assignedTo.firstName %>
                                                    <%= issue.assignedTo.lastName %>
                                            </h5>
                                            <p><b>Username:</b> @<%= issue.assignedTo.username %>
                                            </p>
                                            <p><b>ID:</b>
                                                <%= issue.assignedTo.employeeId %>
                                            </p>
                                            <p><b>Email:</b>
                                                <%= issue.assignedTo.email %>
                                            </p>
                                            <p><b>Phone:</b>
                                                <%= issue.assignedTo.phone %>
                                            </p>
                                        </div>

                                        <% } else { %>

                                            <span class="text-muted">Not Assigned</span>

                                            <% } %>

                                </div>
                            </td>

                            <td>

                                <!-- Assign -->
                                <form action="/dashboard/admin/<%= issue._id %>/assign?_method=PUT" method="POST"
                                    class="assign-form">
                                    <select name="employeeId" required>
                                        <option disabled selected>Select</option>
                                        <% employees.forEach(emp=> { %>
                                            <option value="<%= emp._id %>">
                                                <%= emp.username %>
                                            </option>
                                            <% }) %>
                                    </select>
                                    <button>Assign</button>
                                </form>

                                <!-- Review -->
                                <% if(issue.status==="pending-review" ){ %>
                                    <div class="review-actions">
                                        <a href="/dashboard/admin/<%= issue._id %>/review">View</a>

                                        <form action="/dashboard/admin/<%= issue._id %>/approve?_method=PUT"
                                            method="POST">
                                            <button>Approve</button>
                                        </form>

                                        <form action="/dashboard/admin/<%= issue._id %>/reject?_method=PUT"
                                            method="POST">
                                            <button>Reject</button>
                                        </form>
                                    </div>
                                    <% } %>

                            </td>

                        </tr>

                        <% }) %>
                </tbody>
            </table>
        </div>

        <!-- ===== MOBILE CARDS ===== -->
        <div class="mobile-issues">

            <% issues.forEach((issue, index)=> { %>

                <div class="issue-card">

                    <!-- HEADER -->
                    <div class="issue-header">
                        <span class="issue-id"><%= index + 1 %></span>
                        <h6>
                            <%= issue.title %>
                        </h6>
                        <span class="status <%= issue.status %>">
                            <%= issue.status %>
                        </span>
                    </div>

                    <!-- DETAILS -->
                    <div class="issue-row">
                        <a href="/listings/<%= issue._id %>" class="viewDetails">View Details →</a>
                    </div>

                    <!-- 🔥 ASSIGNED USER (MOBILE WITH CLICK/ACTIVE) -->
                    <div class="issue-row assigned-user">

                        <% if(issue.assignedTo){ %>

                            <span>@<%= issue.assignedTo.username %></span>

                            <div class="user-card">
                                <h5>
                                    <%= issue.assignedTo.firstName %>
                                        <%= issue.assignedTo.lastName %>
                                </h5>
                                <p><b>Username:</b> @<%= issue.assignedTo.username %>
                                </p>
                                <p><b>ID:</b>
                                    <%= issue.assignedTo.employeeId %>
                                </p>
                                <p><b>Email:</b>
                                    <%= issue.assignedTo.email %>
                                </p>
                                <p><b>Phone:</b>
                                    <%= issue.assignedTo.phone %>
                                </p>
                            </div>

                            <% } else { %>

                                <i class="fa-solid fa-user"></i>
                                <span>Not Assigned</span>

                                <% } %>

                    </div>

                    <!-- ACTION -->
                    <form action="/dashboard/admin/<%= issue._id %>/assign?_method=PUT" method="POST"
                        class="issue-action">
                        <select name="employeeId" required>
                            <option disabled selected>Select Employee</option>
                            <% employees.forEach(emp=> { %>
                                <option value="<%= emp._id %>">
                                    <%= emp.username %>
                                </option>
                                <% }) %>
                        </select>
                        <button>Assign</button>
                    </form>

                    <!-- REVIEW -->
                    <% if(issue.status==="pending-review" ){ %>
                        <div class="issue-actions-2">
                            <a href="/dashboard/admin/<%= issue._id %>/review">View</a>

                            <form action="/dashboard/admin/<%= issue._id %>/approve?_method=PUT" method="POST">
                                <button>Approve</button>
                            </form>

                            <form action="/dashboard/admin/<%= issue._id %>/reject?_method=PUT" method="POST">
                                <button>Reject</button>
                            </form>
                        </div>
                        <% } %>

                </div>

                <% }) %>

        </div>

    </div>