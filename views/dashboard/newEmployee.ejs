<% layout("/layouts/boilerplate") %>

<div class="form-page">
    <div class="form-container">
        <div class="form-box">

            <h2>Create Employee</h2>
            <p class="sub-text">Add a new employee to the system</p>

            <form action="/dashboard/admin/employees" method="POST" novalidate class="needs-validation">

                <label>Username</label>
                <input type="text" name="username" required>
                <div class="invalid-feedback">Enter username</div>

                <label>Email</label>
                <input type="email" name="email" required>
                <div class="invalid-feedback">Enter email</div>

                <label>Employee ID</label>
                <input type="text" name="employeeId" required>
                <div class="invalid-feedback">Enter employee ID</div>

                <label>Password</label>
                <input type="password" name="password" required>
                <div class="invalid-feedback">Enter password</div>

                <button class="submit-btn">Create Employee</button>

            </form>

        </div>
    </div>
</div>