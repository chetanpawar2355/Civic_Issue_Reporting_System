<% layout("/layouts/boilerplate") %>

    <div class="row mt-3">
        <div class="col-6 offset-3">
            <br>
            <h1 class="fw-bold">SignUp</h1>
            <br>
        </div>
        <div class="col-6 offset-3">
            <form action="/signup" method="post" class="needs-validation" novalidate>
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input name="username" id="username" placeholder="Enter your username" required type="text"
                        class="form-control">
                    <div class="invalid-feedback">Please enter a username</div>
                    <div class="valid-feedback">Username looks good!</div>
                </div>
                <div class="mb-3">
                    <label for="email" class="form-label">Email</label>
                    <input name="email" id="email" placeholder="Enter your email" required type="email"
                        class="form-control">
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">Password</label>
                    <input name="password" id="password" placeholder="Enter your password" required type="password"
                        class="form-control">
                </div><br>
                <button class="btn btn-success">Sign Up</button><br><br>
            </form>
        </div>
    </div>