<% layout("/layouts/boilerplateWithoutFooter") %>

    <div class="login-page">
        <!-- ❌ CLOSE BUTTON -->
    <a href="/" class="close-btn">
        <i class="fa-solid fa-xmark"></i>
    </a>
        <div class="login-container">

            <!-- LEFT SIDE -->
            <div class="login-left">
                <div class="left-content">

                    <h1>Create Account<br>Join Your <span class="text-warning">City!</span></h1>

                    <p>
                        Join the movement. Report issues and help build a safer, smarter city.
                    </p>
                </div>
            </div>

            <!-- RIGHT SIDE -->
            <div class="login-right">
                <div class="login-box">

                    <h2>Create a new account</h2>
                    <p class="sub-text">Get started by filling your details below.</p>

                    <form action="/signup" method="post" class="needs-validation" novalidate>

                        <label for="username" class="form-label">USERNAME</label>
                        <input id="username" class="form-control" type="text" name="username"
                            placeholder="Enter username" required>
                        <div class="invalid-feedback">Please enter username</div>

                        <label for="email" class="form-label">EMAIL</label>
                        <input id="email" class="form-control" type="email" name="email" placeholder="Enter email"
                            required>
                        <div class="invalid-feedback">Please enter a valid email</div>

                        <label for="password" class="form-label">PASSWORD</label>
                        <input id="password" class="form-control" type="password" name="password"
                            placeholder="Enter password" required>
                        <div class="invalid-feedback">Please enter password</div>

                        <button type="submit">Sign up</button>

                        <p class="signup-text">
                            Already have an account?
                            <a href="/login">Sign in</a>
                        </p>

                    </form>

                    <p>
                        By signing up, you agree to the SheherSetu
                        <a href="/terms">Terms of Service</a> and
                        <a href="/privacy">Privacy Policy</a>.
                    </p>

                </div>
            </div>

        </div>
    </div>