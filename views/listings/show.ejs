<% layout("/layouts/boilerplate") %>
    <div class="row mt-3">
        <div class="col-6 offset-3">
            <br>
            <h3 class="fw-bold">
                <%= listing.title %>
            </h3>
            <br>
        </div>
        <div class="card listing-card col-6 offset-3 show-card">
            <img src="<%= listing.image.url %>" class="card-img-top show-img card-img-top3" width="500px"
                alt="listing_image">

            <div class="card-body">
                <p class="card-text">
                    <%= listing.description %>
                </p>
                <p>
                    <% let statusClass="" ; if(listing.status==="pending" ) { statusClass="bg-warning text-dark" ; }
                        else if(listing.status==="assigned" ) { statusClass="bg-primary" ; } else
                        if(listing.status==="in-progress" ) { statusClass="bg-info text-dark" ; } else
                        if(listing.status==="pending-review" ) { statusClass="bg-secondary" ; } else
                        if(listing.status==="resolved" ) { statusClass="bg-success" ; } %>
                        <span class="badge <%= statusClass %> text-capitalize">
                            <%= listing.status.replace("-", " " ) %>
                        </span>
                </p>
                <p class="card-text">
                    <%= listing.location %>
                </p>
                <p class="card-text">
                    <%= listing.state %>
                </p>
            </div>
        </div>


        <% if(currentUser && listing.owner && listing.owner._id.equals(currentUser._id)) { %>
            <div class="btns">
                <a class="add-btn btn offset-5" href="/listings/<%= listing._id %>/edit">Edit</a>

                <form action="/listings/<%= listing._id %>?_method=DELETE" method="post">
                    <button class="btn btn-dark offset-4">Delete</button>
                </form>

            </div>
            <% } %>

        <div class="col-6 offset-3">
            <br>
            <hr>
            <form action="/listings/<%= listing._id%>/reviews" method="POST" class="needs-validation" novalidate>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control"
                        required></textarea>
                    <div class="invalid-feedback">Please provide a comment.</div>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        </div>
        <div class="col-6 offset-3 mb-3">
            <br>
            <hr>
            <h5 class="fw-bold">Reviews</h5>
            <% for(let review of listing.reviews) { %>
                <div class="card mb-2  borderAdd">
                    <div class="card-body">
                        <p>
                            @<%= review.author.username %>
                        </p>
                        <p>
                            <%= review.comment %>
                        </p>
                    </div>
                </div>
                <% } %>
        </div>
    </div>