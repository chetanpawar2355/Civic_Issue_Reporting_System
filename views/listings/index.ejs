<% layout("/layouts/boilerplate") %>
    <br><br>
    <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4">
        <% for(let listing of allListings){ %>
            <a href="/listings/<%= listing._id %>" class="listing-link listing-link2">
                <div class="card listing-card listing-card2">
                    <img src="<%= listing.image.url %>" class="card-img-top card-img-top2" alt="Listing_image"
                        style="height: 17.5rem">
                    <div class="card-img-overlay card-img-overlay2"></div>

                    <div class="card-body card-body2 px-3">
                        <div class="fw-bold mb-2">
                            <%= listing.title %>
                        </div>

                        <% let statusClass="" ; if(listing.status==="pending" ) { statusClass="bg-warning text-dark" ; }
                            else if(listing.status==="assigned" ) { statusClass="bg-primary" ; } else
                            if(listing.status==="in-progress" ) { statusClass="bg-info text-dark" ; } else
                            if(listing.status==="pending-review" ) { statusClass="bg-secondary" ; } else
                            if(listing.status==="resolved" ) { statusClass="bg-success" ; } %>

                            <div class="d-flex justify-content-between align-items-center w-100">
                                <span class="badge <%= statusClass %> text-capitalize">
                                    <%= listing.status.replace("-", " " ) %>
                                </span>
                                <p class="createdDate m-0">
                                    <%= listing.createdAt.toLocaleDateString() %>
                                </p>
                            </div>
                    </div>
                </div>
            </a>
            <% } %>
    </div>