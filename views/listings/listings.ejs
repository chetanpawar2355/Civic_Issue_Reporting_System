<% layout("/layouts/boilerplate") %>
    <div class="main-title">
        <h2 class="fw-bold title-strip">
            Track Complaints
        </h2>
    </div>

    <div class="main-listing">
        <% if(allListings.length===0) { %>

            <p class="text-center mt-5">No issues found</p>

            <% } else { %>
                <div class="row row-cols-lg-4 row-cols-md-2 row-cols-sm-1 g-4 main-cards">
                    <% for(let listing of allListings){ %>

                        <!-- 🔥 IMPORTANT WRAPPER -->
                        <div class="col">
                            <div class="listing-card">

                                <div class="img-wrapper">
                                    <img src="<%= listing.image.url %>" alt="Listing Image">
                                    <span class="status-badge <%= listing.status %>">
                                        <%= listing.status.replace("-", " " ) %>
                                    </span>
                                </div>

                                <div class="card-content">
                                    <h6 class="title">
                                        <%= listing.title %>
                                    </h6>

                                    <div class="card-footer">
                                        <span class="date">
                                            <%= listing.createdAt.toLocaleDateString() %>
                                        </span>

                                        <a href="/listings/<%= listing._id %>" class="view-btn">
                                            View
                                        </a>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <% } %>
                </div>
                <% } %>
    </div>