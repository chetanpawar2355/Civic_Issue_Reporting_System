<% layout("/layouts/boilerplate") %>

    <div class="form-page">

    <div class="form-container">

        <div class="form-box">
            <h2 class="fw-bold">Spot an Issue? <span class="text-warning">Let Us Know</span></h2>
            <p class="sub-text">Report a civic issue quickly and easily.</p>

            <form action="/listings" method="post" class="needs-validation" novalidate enctype="multipart/form-data">

                <label class="form-label">TITLE</label>
                <input name="listing[title]" id="title" placeholder="Add a title" required type="text" class="form-control">
                <div class="invalid-feedback">Enter title</div>

                <label class="form-label">DESCRIPTION</label>
                <textarea name="listing[description]" id="description" placeholder="Enter description" required
                    class="form-control"></textarea>
                <div class="invalid-feedback">Enter description</div>

                <label class="form-label">UPLOAD IMAGE</label>
                <input name="listing[image]" id="image" type="file" class="form-control" required>
                <div class="invalid-feedback">Upload an image</div>

                <label class="form-label">LOCATION</label>
                <input type="text" name="listing[location]" id="location" class="form-control" placeholder="Enter location" required>
                <div class="invalid-feedback">Enter location</div>

                <label class="form-label">STATE</label>
                <input type="text" name="listing[state]" id="state" class="form-control" placeholder="Enter state" required>
                <div class="invalid-feedback">Enter state</div>

                <button class="submit-btn">REPORT ISSUE</button>

            </form>

        </div>

    </div>
</div>