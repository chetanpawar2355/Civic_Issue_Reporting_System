<% layout("/layouts/boilerplate") %>

    <div class="container mt-5 d-flex justify-content-center">
        <div class="profile-card p-4">
            <div class="text-center">
                <div class="profile-avatar mb-3">
                    <i class="fa-regular fa-user"></i>
                </div>
                <h3 class="mb-0">
                    <%= user.firstName %>
                        <%= user.lastName %>
                </h3>
                <p class="text-muted">@<%= user.username %>
                </p>
                <span class="badge text-capitalize 
    <%= user.role === 'admin' ? 'bg-danger' : '' %>
    <%= user.role === 'employee' ? 'bg-warning text-dark' : '' %>
    <%= user.role === 'client' ? 'bg-primary' : '' %>
">
                    <%= user.role %>
                </span>
            </div>
            <hr>
            <div class="mt-3">
                <p class="small-hidden" title="<%= user.email %>"><strong>Email:</strong>
                    <%= user.email %>
                </p>

                <p><strong>Phone:</strong>
                    <%= user.phone %>
                </p>
            </div>

            <div class="text-center mt-4">
                <a href="/profile/edit" class="btn submit-btn px-4">Edit Profile</a>
            </div>

        </div>

    </div>